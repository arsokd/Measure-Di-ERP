rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to get the current user's employee document
    function getUserData() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data;
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user has a specific role
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // Helper function to check if user is super_admin
    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    // Helper function to check if user is leadership or super_admin
    function isLeadershipOrAdmin() {
      return isAuthenticated() && (getUserData().role in ['super_admin', 'leadership', 'admin']);
    }

    // Helper function to check if user owns the record or is an admin
    function isOwnerOrAdmin(employeeIdField) {
      return isAuthenticated() && (
        getUserData().employeeId == resource.data[employeeIdField] || 
        isLeadershipOrAdmin()
      );
    }

    // Employees Collection
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isLeadershipOrAdmin();
    }

    // Users Collection (auth mappings)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isLeadershipOrAdmin());
      allow delete: if isLeadershipOrAdmin();
    }

    // Commercial Leads Collection
    match /leads/{leadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.employeeId == getUserData().employeeId || 
        isLeadershipOrAdmin()
      );
    }

    // Commercial Orders Collection
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isLeadershipOrAdmin();
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isLeadershipOrAdmin();
    }

    // Service Tickets Collection
    match /serviceTickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // Field engineers need to update status
      allow delete: if isLeadershipOrAdmin();
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.employeeId == getUserData().employeeId;
      allow update: if isAuthenticated() && (
        resource.data.employeeId == getUserData().employeeId || 
        isLeadershipOrAdmin()
      );
      allow delete: if isLeadershipOrAdmin();
    }

    // DWM Activities Collection
    match /dwmActivities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.employeeId == getUserData().employeeId || 
        isLeadershipOrAdmin()
      );
    }

    // KRA Targets Collection
    match /kraTargets/{kraId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isLeadershipOrAdmin();
    }

    // AOP Targets Collection
    match /aopTargets/{aopId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isLeadershipOrAdmin();
    }

    // Performance Reviews Collection
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create, update: if isLeadershipOrAdmin();
      allow delete: if isSuperAdmin();
    }

    // Expense Vouchers Collection
    match /expenseVouchers/{voucherId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isLeadershipOrAdmin();
    }

    // Travel Pre-Approvals Collection
    match /travelPreApprovals/{approvalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isLeadershipOrAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
